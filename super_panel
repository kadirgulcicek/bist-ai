"""
Süper Panel - Tüm özellikler tek menüde
"""

import os

def menu():
    while True:
        print("\n" + "=" * 50)
        print("BIST AI - SÜPER PANEL")
        print("=" * 50)
        print("1. Portföy Yönetimi")
        print("2. İşlem Geçmişi")
        print("3. Stop-Loss Kontrol")
        print("4. Excel Raporu")
        print("5. Grafikler")
        print("6. Çıkış")
        
        secim = input("\nSeçiminiz (1-7): ").strip()
        
        if secim == "1":
            os.system("py -3.14 portfoy.py")
        elif secim == "2":
            os.system("py -3.14 islem_gecmisi.py")
        elif secim == "3":
            os.system("py -3.14 stop_loss.py")
        elif secim == "4":
            os.system("py -3.14 excel_aktar.py")
        elif secim == "5":
            os.system("py -3.14 grafik_ciz.py")
        elif secim == "6":
            print("Görüşürüz!")
            break

if __name__ == "__main__":
    menu()
